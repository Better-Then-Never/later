rules_version = '2';

// Least-privilege Storage rules (see docs/refactor/FIREBASE_AUDIT.md §2.4).
// Images shown to other users are loaded through download URLs (with a
// token), which do not go through these rules. Tested by tools/rules-tests.
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function isMe(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Uploads must be images below [maxBytes]; deletes have no resource.
    function imageUpload(maxBytes) {
      return request.resource == null
        || (request.resource.contentType.matches('image/.*')
          && request.resource.size <= maxBytes);
    }

    // Profile picture, its thumbnail and the profile background.
    match /userdata/{uid}/assets/images/{name} {
      allow read: if signedIn();
      allow write: if isMe(uid)
        && name in ['profile_image', 'profile_image_small', 'background_image']
        && imageUpload(5 * 1024 * 1024);
    }

    // Capsule photos (the app stores them as image.jpg, compressed) and the
    // frames of a loop capsule (frame_0.jpg ... frame_9.jpg, smaller).
    match /userdata/{uid}/capsules/{capsuleId}/{file} {
      allow read: if isMe(uid);
      allow write: if isMe(uid)
        && ((file == 'image.jpg' && imageUpload(10 * 1024 * 1024))
          || (file.matches('frame_[0-9][.]jpg')
            && imageUpload(3 * 1024 * 1024)));
    }

    // Photos sent in a chat (chats/{uidA_uidB}/{sender}/{id}.jpg): the
    // sender uploads and may delete them; both participants may read. The
    // app shows them through download URLs, like capsule photos.
    match /chats/{chatId}/{senderId}/{name} {
      function members() {
        return chatId.split('_');
      }

      allow read: if signedIn() && members().size() == 2
        && request.auth.uid in members();
      // resource == null: a sent photo is never replaced (the emulator treats
      // writing over an existing file as a create too).
      allow create: if resource == null && isMe(senderId)
        && members().size() == 2
        && senderId in members()
        && name.matches('[A-Za-z0-9]{1,40}[.]jpg')
        && imageUpload(5 * 1024 * 1024);
      allow delete: if isMe(senderId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
