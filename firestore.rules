rules_version = '2';

// Least-privilege rules for the data model in docs/refactor/FIREBASE_AUDIT.md.
// Tested by tools/rules-tests (emulator). Deploy only after the refactored
// app is rolled out: see docs/refactor/MIGRATIONS_NEEDED.md.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- helpers -----------------------------------------------------------

    function signedIn() {
      return request.auth != null;
    }

    function me() {
      return request.auth.uid;
    }

    function isMe(uid) {
      return signedIn() && me() == uid;
    }

    function myFriends() {
      return get(/databases/$(database)/documents/users/$(me())).data.get('friends', []);
    }

    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function validUsername(u) {
      return u is string && u.matches('^[a-z0-9._-]{3,30}$');
    }

    function validName(n) {
      return n is string && n.size() > 0 && n.size() <= 100;
    }

    function isServerTime(t) {
      return t == request.time;
    }

    // users/{uid}/blocked/{other} exists: uid blocked other.
    function blocked(uid, other) {
      return exists(/databases/$(database)/documents/users/$(uid)/blocked/$(other));
    }

    // friend_requests/{from}_{to} is accepted once this write is done.
    function acceptedAfter(from, to) {
      return getAfter(/databases/$(database)/documents/friend_requests/$(from + '_' + to))
        .data.get('status', '') == 'accepted';
    }

    // ---- users -------------------------------------------------------------

    match /users/{uid} {
      // Profiles are needed for search, friend lists and avatars. They must
      // not contain private data: see MIGRATIONS_NEEDED.md (email, fcmToken).
      allow read: if signedIn();

      // Created together with usernames/{username} in one transaction.
      allow create: if isMe(uid)
        && request.resource.data.keys().hasOnly(
          ['uid', 'name', 'username', 'friends', 'favorites', 'createdAt'])
        && request.resource.data.uid == uid
        && validName(request.resource.data.name)
        && validUsername(request.resource.data.username)
        && request.resource.data.friends == []
        && request.resource.data.favorites == []
        && isServerTime(request.resource.data.createdAt)
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username))
          .data.uid == uid;

      allow update: if ownerUpdate(uid) || friendshipEdit(uid);
      allow delete: if false;

      function ownerUpdate(uid) {
        let d = request.resource.data;
        let keys = changed();
        return isMe(uid)
          && keys.hasOnly(['name', 'username', 'friends', 'favorites',
            'showAchievements',
            // Legacy fields of older app versions may only be removed.
            'email', 'fcmToken', 'fcmTokenUpdatedAt', 'blockedUsers'])
          && (!keys.hasAny(['name']) || validName(d.name))
          && (!keys.hasAny(['username']) || (validUsername(d.username)
            && getAfter(/databases/$(database)/documents/usernames/$(d.username)).data.uid == uid))
          && (!keys.hasAny(['favorites'])
            || (d.favorites is list && d.favorites.size() <= 1000))
          && (!keys.hasAny(['friends']) || ownFriendsChange(uid))
          && (!keys.hasAny(['showAchievements']) || d.showAchievements is bool)
          && !(keys.hasAny(['email']) && d.keys().hasAny(['email']))
          && !(keys.hasAny(['fcmToken']) && d.keys().hasAny(['fcmToken']))
          && !(keys.hasAny(['fcmTokenUpdatedAt'])
            && d.keys().hasAny(['fcmTokenUpdatedAt']))
          // main's app kept blocks in this array; now users/{uid}/blocked.
          && !(keys.hasAny(['blockedUsers']) && d.keys().hasAny(['blockedUsers']));
      }

      // The owner may remove friends freely, and add one friend only while
      // accepting that friend's request in the same batch.
      function ownFriendsChange(uid) {
        let added = request.resource.data.friends
          .removeAll(resource.data.get('friends', []));
        return request.resource.data.friends is list
          && (added.size() == 0
            || (added.size() == 1 && acceptedAfter(added[0], uid)));
      }

      // Another user may only add or remove themselves: adding requires
      // accepting this user's request in the same batch.
      function friendshipEdit(uid) {
        let before = resource.data.get('friends', []);
        let after = request.resource.data.get('friends', []);
        let added = after.removeAll(before);
        let removed = before.removeAll(after);
        return signedIn() && me() != uid
          && changed().hasOnly(['friends'])
          && after is list
          && ((added.size() == 0 && removed.size() == 0)
            || (added == [me()] && removed.size() == 0
              && acceptedAfter(uid, me()))
            || (removed == [me()] && added.size() == 0));
      }

      // users/{uid}/settings/app: the user's own settings. The Cloud
      // Functions (admin) read them before sending a push.
      match /settings/{doc} {
        allow read: if isMe(uid);
        allow create, update: if isMe(uid) && doc == 'app'
          && validSettings(request.resource.data);
        allow delete: if false;

        function isBool(m, key) {
          return m.get(key, true) is bool;
        }

        function isMinute(m, key) {
          return m.get(key, 0) is int && m.get(key, 0) >= 0
            && m.get(key, 0) < 1440;
        }

        function validNotifications(n) {
          let q = n.get('quietHours', {});
          return n is map
            && n.keys().hasOnly(['enabled', 'messages', 'follows', 'capsules',
              'friendRequests', 'reactions', 'comments', 'achievements', 'news',
              'streakReminder', 'preview', 'sound', 'quietHours',
              'utcOffsetMinutes'])
            && isBool(n, 'enabled') && isBool(n, 'messages')
            && isBool(n, 'follows') && isBool(n, 'capsules')
            && isBool(n, 'friendRequests') && isBool(n, 'reactions')
            && isBool(n, 'comments') && isBool(n, 'achievements')
            && isBool(n, 'news') && isBool(n, 'streakReminder')
            && isBool(n, 'preview') && isBool(n, 'sound')
            && q is map && q.keys().hasOnly(['enabled', 'start', 'end'])
            && isBool(q, 'enabled') && isMinute(q, 'start') && isMinute(q, 'end')
            && n.get('utcOffsetMinutes', 0) is int
            && n.get('utcOffsetMinutes', 0) >= -840
            && n.get('utcOffsetMinutes', 0) <= 840;
        }

        function validPrivacy(p) {
          return p is map
            && p.keys().hasOnly(['defaultVisibility', 'readReceipts',
              'locationPrecision', 'contactSuggestions'])
            && p.get('defaultVisibility', 'public') in ['public', 'friends', 'private']
            && isBool(p, 'readReceipts') && isBool(p, 'contactSuggestions')
            && p.get('locationPrecision', 'exact') in ['exact', 'approximate'];
        }

        function validSettings(d) {
          return d.keys().hasOnly(['notifications', 'mutedChats', 'language',
              'privacy', 'pinnedChats'])
            && validNotifications(d.get('notifications', {}))
            && d.get('language', 'en') in ['en', 'ru', 'pl', 'de', 'es']
            && validPrivacy(d.get('privacy', {}))
            && d.get('mutedChats', []) is list
            && d.get('mutedChats', []).size() <= 500
            && d.get('pinnedChats', []) is list
            && d.get('pinnedChats', []).size() <= 10;
        }
      }

      // Unlocked by the Cloud Functions only. Friends see them unless the
      // owner turned showAchievements off.
      match /achievements/{achievementId} {
        allow read: if isMe(uid)
          || (signedIn()
            && get(/databases/$(database)/documents/users/$(uid)).data.get('showAchievements', true) == true
            && me() in get(/databases/$(database)/documents/users/$(uid)).data.get('friends', []));
        allow write: if false;
      }

      // Server-side bookkeeping (place cells, last position): owner only.
      match /private/{doc} {
        allow read: if isMe(uid);
        allow write: if false;
      }

      // users/{uid}/blocked/{other}: uid blocked other. Only the two of them
      // may see it (the blocked user's app hides the message box).
      match /blocked/{other} {
        allow get: if isMe(uid) || isMe(other);
        allow list, delete: if isMe(uid);
        allow create: if isMe(uid) && other != uid
          && request.resource.data.keys().hasOnly(['blockedAt'])
          && isServerTime(request.resource.data.blockedAt);
      }

      // One document per device token, private to the user.
      match /fcmTokens/{token} {
        allow read, delete: if isMe(uid);
        allow create, update: if isMe(uid)
          && request.resource.data.keys().hasOnly(['token', 'platform', 'updatedAt'])
          && request.resource.data.token == token
          && request.resource.data.platform in ['android', 'ios', 'web', 'other']
          && isServerTime(request.resource.data.updatedAt);
      }

      match /notifications/{notificationId} {
        allow read, delete: if isMe(uid);
        allow update: if isMe(uid)
          && changed().hasOnly(['isRead'])
          && request.resource.data.isRead == true;
        // Other users may only leave a "started following you" notice, as
        // themselves, after following. Everything else is written by the
        // Cloud Functions (admin SDK).
        allow create: if signedIn() && me() != uid
          && request.resource.data.keys().hasOnly(['type', 'fromUserId',
            'fromUserName', 'fromUserAvatar', 'message', 'timestamp', 'isRead'])
          && request.resource.data.type == 'follow'
          && request.resource.data.fromUserId == me()
          && request.resource.data.fromUserName is string
          && request.resource.data.fromUserName.size() <= 100
          && request.resource.data.fromUserAvatar == ''
          && request.resource.data.message == 'started following you'
          && request.resource.data.isRead == false
          && isServerTime(request.resource.data.timestamp)
          && exists(/databases/$(database)/documents/users/$(uid)/followers/$(me()));
      }

      // Create and update: following again re-writes the same documents.
      match /following/{target} {
        allow read, delete: if isMe(uid);
        allow create, update: if isMe(uid) && target != uid
          && request.resource.data.keys().hasOnly(['followedAt', 'notificationsEnabled'])
          && isServerTime(request.resource.data.followedAt)
          && request.resource.data.notificationsEnabled is bool;
      }

      match /followers/{follower} {
        allow read: if isMe(uid) || isMe(follower);
        allow create, update: if isMe(follower) && follower != uid
          && request.resource.data.keys().hasOnly(['followedAt'])
          && isServerTime(request.resource.data.followedAt)
          && existsAfter(/databases/$(database)/documents/users/$(follower)/following/$(uid));
        allow delete: if isMe(follower) || isMe(uid);
      }
    }

    // ---- usernames ---------------------------------------------------------

    // usernames/{username} = {uid}: makes usernames unique. Written in the
    // same transaction as users/{uid}.username.
    match /usernames/{username} {
      allow read: if signedIn();
      allow create: if signedIn()
        && validUsername(username)
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == me()
        && getAfter(/databases/$(database)/documents/users/$(me())).data.username == username;
      allow delete: if signedIn()
        && resource.data.uid == me()
        && getAfter(/databases/$(database)/documents/users/$(me())).data.username != username;
      allow update: if false;
    }

    // ---- friend requests ---------------------------------------------------

    // friend_requests/{fromUserId}_{toUserId}. Auth uids never contain "_".
    match /friend_requests/{requestId} {
      function participant() {
        let parts = requestId.split('_');
        return signedIn() && parts.size() == 2 && me() in parts;
      }

      function validNew() {
        let d = request.resource.data;
        return d.keys().hasOnly(['fromUserId', 'toUserId', 'status', 'createdAt'])
          && requestId == d.fromUserId + '_' + d.toUserId
          && d.fromUserId == me()
          && d.toUserId is string && d.toUserId != me()
          && d.status == 'pending'
          && isServerTime(d.createdAt);
      }

      allow read: if signedIn()
        && (resource.data.fromUserId == me() || resource.data.toUserId == me());
      allow create: if signedIn() && validNew();
      allow update: if signedIn() && (
        // The sender sends again while it is still pending.
        (resource.data.fromUserId == me() && resource.data.status == 'pending'
          && validNew())
        // The receiver accepts.
        || (resource.data.toUserId == me() && resource.data.status == 'pending'
          && changed().hasOnly(['status', 'acceptedAt'])
          && request.resource.data.status == 'accepted'
          && isServerTime(request.resource.data.acceptedAt)));
      // Cancel, reject and unfriend; deleting a missing request is allowed.
      allow delete: if participant();
    }

    // ---- capsules ----------------------------------------------------------

    match /capsules/{capsuleId} {
      function canSee() {
        return resource.data.ownerId == me()
          || resource.data.privacy == 'public'
          || (resource.data.privacy == 'friends'
            && resource.data.ownerId in myFriends())
          // A capsule sent to a friend (see validCapsule).
          || me() in resource.data.get('sharedWith', [])
          // Its co-authors.
          || me() in resource.data.get('coAuthors', []);
      }

      allow get: if signedIn() && (resource == null || canSee());
      allow list: if signedIn() && canSee();

      allow create: if signedIn() && validCapsule();
      allow delete: if signedIn() && resource.data.ownerId == me();
      // Nobody edits a capsule; a co-author may only take themselves off it.
      allow update: if signedIn() && me() in resource.data.get('coAuthors', [])
        && changed().hasOnly(['coAuthors'])
        && request.resource.data.coAuthors.toSet()
          == resource.data.coAuthors.toSet().difference([me()].toSet())
        && request.resource.data.coAuthors.size()
          == resource.data.coAuthors.size() - 1;

      // Reactions: one per person (document id = uid), counted by a function.
      match /reactions/{uid} {
        allow read: if signedIn() && canSeeCapsule(capsuleId);
        allow create, update: if isMe(uid) && canSeeCapsule(capsuleId)
          && capsuleData(capsuleId).get('allowReactions', true) == true
          && !blocked(capsuleData(capsuleId).ownerId, me())
          && request.resource.data.keys().hasOnly(['type', 'uid', 'updatedAt'])
          && request.resource.data.type in ['heart', 'laugh', 'wow', 'sad', 'fire', 'clap']
          && request.resource.data.uid == me()
          && isServerTime(request.resource.data.updatedAt);
        allow delete: if isMe(uid);
      }

      // Comments: one level of replies, never edited; the author or the
      // capsule owner deletes them.
      match /comments/{commentId} {
        allow read: if signedIn() && canSeeCapsule(capsuleId);
        allow create: if signedIn() && canSeeCapsule(capsuleId)
          && capsuleData(capsuleId).get('allowComments', true) == true
          && !blocked(capsuleData(capsuleId).ownerId, me())
          && validComment(request.resource.data);
        allow delete: if signedIn() && (resource.data.authorId == me()
          || capsuleData(capsuleId).ownerId == me());
        allow update: if false;

        function validComment(d) {
          return d.keys().hasOnly(['authorId', 'text', 'createdAt', 'replyTo'])
            && d.authorId == me()
            && d.text is string && d.text.size() > 0 && d.text.size() <= 500
            && isServerTime(d.createdAt)
            && (!d.keys().hasAny(['replyTo'])
              || (d.replyTo is string
                && exists(/databases/$(database)/documents/capsules/$(capsuleId)/comments/$(d.replyTo))
                && get(/databases/$(database)/documents/capsules/$(capsuleId)/comments/$(d.replyTo))
                  .data.get('replyTo', null) == null));
        }
      }

      function validCapsule() {
        let d = request.resource.data;
        return d.keys().hasOnly(['ownerId', 'imageUrl', 'title', 'description',
            'location', 'privacy', 'createdAt', 'isScheduled', 'openAt', 'color',
            'sharedWith', 'capturedAt', 'utcOffsetMinutes', 'showAuthor',
            'allowComments', 'allowReactions', 'locationPrecision', 'frames',
            'frameDelayMs', 'thumbUrl', 'placeName', 'coAuthors'])
          && d.keys().hasAll(['ownerId', 'imageUrl', 'title', 'location',
            'privacy', 'createdAt', 'color'])
          && d.ownerId == me()
          && d.imageUrl is string && d.imageUrl.size() <= 2048
          && d.title is string && d.title.size() > 0 && d.title.size() <= 100
          && (d.get('description', null) == null
            || (d.description is string && d.description.size() <= 2000))
          && d.location is latlng
          // 0,0 is what a failed location fix looks like, not a real place.
          && (math.abs(d.location.latitude()) > 0.0001
            || math.abs(d.location.longitude()) > 0.0001)
          && d.privacy in ['private', 'friends', 'public']
          && (d.get('capturedAt', request.time) is timestamp)
          && d.get('capturedAt', request.time) <= request.time + duration.value(5, 'm')
          && d.get('utcOffsetMinutes', 0) is int
          && d.get('utcOffsetMinutes', 0) >= -840
          && d.get('utcOffsetMinutes', 0) <= 840
          && d.get('showAuthor', true) is bool
          && d.get('allowComments', true) is bool
          && d.get('allowReactions', true) is bool
          && d.get('locationPrecision', 'exact') in ['exact', 'approximate']
          && d.get('frames', []) is list && d.get('frames', []).size() <= 10
          && d.get('frameDelayMs', 300) is int
          && d.get('frameDelayMs', 300) >= 80 && d.get('frameDelayMs', 300) <= 2000
          && (d.get('thumbUrl', '') is string && d.get('thumbUrl', '').size() <= 2048)
          && (d.get('placeName', '') is string && d.get('placeName', '').size() <= 200)
          && d.color in ['red', 'blue', 'green', 'yellow', 'orange', 'purple']
          && isServerTime(d.createdAt)
          && (d.get('isScheduled', false) is bool)
          && (d.get('openAt', null) == null || d.openAt is timestamp)
          && validCoAuthors(d.get('coAuthors', []))
          // Sent to a friend: shared with exactly the owner and the recipient.
          && (!d.keys().hasAny(['sharedWith'])
            || (d.sharedWith is list && d.sharedWith.size() == 2
              && d.sharedWith[0] == me() && d.sharedWith[1] is string
              && d.sharedWith[1] != me()));
      }
    }

    function capsuleData(id) {
      return get(/databases/$(database)/documents/capsules/$(id)).data;
    }

    // The same visibility as capsules/{id} reads (canSee), for subcollections.
    function canSeeCapsule(id) {
      let c = capsuleData(id);
      return c.ownerId == me()
        || c.privacy == 'public'
        || (c.privacy == 'friends' && c.ownerId in myFriends())
        || me() in c.get('sharedWith', [])
        || me() in c.get('coAuthors', []);
    }

    // Up to five co-authors of a capsule: each a friend of its owner (who
    // is not one of them). Rules have no loops, hence one check per place.
    function validCoAuthors(c) {
      return c is list && c.size() <= 5 && !(me() in c)
        && c.toSet().size() == c.size()
        && (c.size() < 1 || c[0] in myFriends())
        && (c.size() < 2 || c[1] in myFriends())
        && (c.size() < 3 || c[2] in myFriends())
        && (c.size() < 4 || c[3] in myFriends())
        && (c.size() < 5 || c[4] in myFriends());
    }

    // ---- reports and announcements -------------------------------------------

    // Reports: write-only; the owner reviews them in the console.
    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['reporterId', 'targetType',
          'targetPath', 'reason', 'details', 'createdAt'])
        && request.resource.data.reporterId == me()
        && request.resource.data.targetType in ['capsule', 'comment', 'user', 'message', 'sticker']
        && request.resource.data.targetPath is string
        && request.resource.data.targetPath.size() <= 300
        && request.resource.data.reason in ['spam', 'abuse', 'nudity', 'violence', 'privacy', 'other']
        && request.resource.data.get('details', '') is string
        && request.resource.data.get('details', '').size() <= 1000
        && isServerTime(request.resource.data.createdAt);
      allow read, update, delete: if false;
    }

    // Announcements: written by the admin-only sendAnnouncement function.
    match /announcements/{announcementId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // ---- chats -------------------------------------------------------------

    // chats/{uidA}_{uidB} (uids sorted): the two participants read and write
    // it; nobody writes to someone who blocked them (or whom they blocked).
    // Same shape as the chats of main's app.
    //
    // chats/g_{id}: a group. Its members (up to 20) are listed in `members`,
    // not `participants`, so apps that know only two-person chats never list
    // it. It starts with its creator alone; members invite people
    // (invites/{uid}) and a function adds those it accepts: friends of the
    // inviter who blocked nobody in the group (rules cannot check a list of
    // people). Any member may rename it or leave.
    match /chats/{chatId} {
      function members() {
        return chatId.split('_');
      }

      function isGroupId() {
        return chatId.matches('g_[A-Za-z0-9]{10,40}');
      }

      function isMember() {
        return signedIn() && !isGroupId() && members().size() == 2
          && me() in members();
      }

      // A group's members as stored (for its messages and hints).
      function groupMembers() {
        return get(/databases/$(database)/documents/chats/$(chatId)).data
          .get('members', []);
      }

      function inGroup() {
        return signedIn() && isGroupId() && me() in groupMembers();
      }

      // For the group document itself.
      function inThisGroup() {
        return signedIn() && isGroupId()
          && me() in resource.data.get('members', []);
      }

      function chatMembers() {
        return isGroupId() ? groupMembers() : members();
      }

      function validGroupName(n) {
        return n is string && n.size() > 0 && n.size() <= 60;
      }

      function isGroupCreate() {
        let d = request.resource.data;
        return signedIn() && isGroupId()
          && d.keys().hasOnly(['members', 'name', 'createdBy', 'createdAt',
            'lastMessage', 'lastUpdated', 'lastSenderId'])
          && d.members == [me()]
          && d.createdBy == me() && validGroupName(d.name)
          && isServerTime(d.createdAt) && d.lastMessage == ''
          && isServerTime(d.lastUpdated)
          && d.get('lastSenderId', me()) == me();
      }

      function isGroupSend() {
        let d = request.resource.data;
        return changed().hasOnly(['lastMessage', 'lastUpdated', 'lastSenderId'])
          && d.lastMessage != '' && validSummary(d) && d.lastSenderId == me();
      }

      function isGroupRead() {
        let d = request.resource.data;
        return changed().hasOnly(['lastReadAt'])
          && d.lastReadAt.diff(resource.data.get('lastReadAt', {}))
            .affectedKeys().hasOnly([me()])
          && d.lastReadAt[me()] == request.time;
      }

      // Deleting the newest message: the summary shows the one before it (any
      // member's, with its own time), or nothing.
      function isGroupUndo() {
        let d = request.resource.data;
        return changed().hasOnly(['lastMessage', 'lastUpdated', 'lastSenderId'])
          && d.lastMessage is string && d.lastMessage.size() <= 2000
          && d.lastUpdated is timestamp && d.lastUpdated <= request.time
          && d.get('lastSenderId', me()) in resource.data.members;
      }

      function isGroupRename() {
        return changed().hasOnly(['name'])
          && validGroupName(request.resource.data.name);
      }

      // Leaving: only yourself goes (and your read mark with you).
      function isGroupLeave() {
        let d = request.resource.data;
        return changed().hasOnly(['members', 'lastReadAt'])
          && d.members.toSet() == resource.data.members.toSet().difference([me()].toSet())
          && d.members.size() == resource.data.members.size() - 1
          && (!changed().hasAny(['lastReadAt'])
            || d.lastReadAt.keys().toSet()
              == resource.data.get('lastReadAt', {}).keys().toSet()
                .difference([me()].toSet()));
      }

      function other() {
        return members()[0] == me() ? members()[1] : members()[0];
      }

      function mayWrite() {
        return !blocked(other(), me()) && !blocked(me(), other());
      }

      function validSummary(d) {
        return d.lastMessage is string
          && d.lastMessage.size() <= 2000
          && isServerTime(d.lastUpdated);
      }

      // unreadCounts {uid: n}: what each participant has not read yet.
      function unreadChanged() {
        return request.resource.data.get('unreadCounts', {})
          .diff(resource.data.get('unreadCounts', {})).affectedKeys();
      }

      function unreadBefore(uid) {
        return resource.data.get('unreadCounts', {}).get(uid, 0);
      }

      function unreadAfter(uid) {
        return request.resource.data.get('unreadCounts', {}).get(uid, 0);
      }

      // Sending: new summary, and +1 unread for the recipient only.
      function isSend() {
        let d = request.resource.data;
        return changed().hasOnly(['lastMessage', 'lastUpdated', 'lastSenderId',
            'unreadCounts'])
          && d.lastMessage != '' && mayWrite() && validSummary(d)
          && (!changed().hasAny(['lastSenderId']) || d.lastSenderId == me())
          && (!changed().hasAny(['unreadCounts'])
            || (unreadChanged().hasOnly([other()])
              && unreadAfter(other()) == unreadBefore(other()) + 1));
      }

      // Reading: my unread count to 0 and my read receipt to now (one write;
      // the other participant's values cannot be touched).
      function isRead() {
        let d = request.resource.data;
        return changed().hasOnly(['unreadCounts', 'lastReadAt'])
          && (!changed().hasAny(['unreadCounts'])
            || (unreadChanged().hasOnly([me()]) && unreadAfter(me()) == 0))
          && (!changed().hasAny(['lastReadAt'])
            || (d.lastReadAt.diff(resource.data.get('lastReadAt', {}))
                .affectedKeys().hasOnly([me()])
              && d.lastReadAt[me()] == request.time));
      }

      // Clearing the history empties the summary and both unread counts.
      function isClear() {
        let d = request.resource.data;
        return changed().hasOnly(['lastMessage', 'lastUpdated', 'unreadCounts'])
          && d.lastMessage == '' && isServerTime(d.lastUpdated)
          && (!changed().hasAny(['unreadCounts']) || d.unreadCounts == {});
      }

      // The sender took back a message the other had not read yet: one
      // fewer unread for the other (never below zero, never your own).
      function unreadDroppedByOne() {
        return unreadChanged().hasOnly([other()])
          && unreadAfter(other()) == unreadBefore(other()) - 1
          && unreadAfter(other()) >= 0;
      }

      function isUnreadDrop() {
        return changed().hasOnly(['unreadCounts']) && unreadDroppedByOne();
      }

      // Deleting the newest message: the summary shows the one before it
      // again, by either participant and with its own time; the unread count
      // drops by one if the other had not read it.
      function isUndo() {
        let d = request.resource.data;
        return changed().hasOnly(['lastMessage', 'lastUpdated', 'lastSenderId',
            'unreadCounts'])
          && (!changed().hasAny(['unreadCounts']) || unreadDroppedByOne())
          && d.lastMessage is string && d.lastMessage != ''
          && d.lastMessage.size() <= 2000
          && d.lastUpdated is timestamp && d.lastUpdated <= request.time
          && d.get('lastSenderId', '') in members();
      }

      // get works before the chat exists (the send transaction reads it).
      allow get: if isMember() || inThisGroup();
      // The app's queries: participants (two-person chats) or members
      // (groups) array-contains me.
      allow list: if signedIn()
        && (me() in resource.data.get('participants', [])
          || me() in resource.data.get('members', []));

      allow create: if isGroupCreate() || isMember() && mayWrite()
        && members()[0] < members()[1]
        && request.resource.data.keys().hasOnly(['participants', 'lastMessage',
          'lastUpdated', 'createdAt', 'lastSenderId', 'unreadCounts'])
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.resource.data.participants.hasAll(members())
        && isServerTime(request.resource.data.createdAt)
        && validSummary(request.resource.data)
        && request.resource.data.get('lastSenderId', me()) == me()
        // The first message is unread for the recipient.
        && (!request.resource.data.keys().hasAny(['unreadCounts'])
          || (request.resource.data.unreadCounts.keys().hasOnly([other()])
            && request.resource.data.unreadCounts[other()] == 1));
      allow update: if (isMember()
          && (isSend() || isRead() || isClear() || isUndo() || isUnreadDrop()))
        || (inThisGroup()
          && (isGroupSend() || isGroupRead() || isGroupRename()
            || isGroupUndo() || isGroupLeave()));
      allow delete: if false;

      // typing/{uid} {at: server time}: "uid is typing", written at most
      // every few seconds while they type, deleted when they stop. Only the
      // participants read it; each writes only their own.
      // invites/{uid} {by, at}: a member asks for uid to join; the function
      // adds them (or not) and deletes the invite.
      match /invites/{uid} {
        allow read: if inGroup();
        allow create: if inGroup() && uid != me()
          && !(uid in groupMembers()) && groupMembers().size() < 20
          && request.resource.data.keys().hasOnly(['by', 'at'])
          && request.resource.data.by == me()
          && request.resource.data.at == request.time;
        allow update, delete: if false;
      }

      match /typing/{uid} {
        allow read: if isMember() || inGroup();
        allow create, update: if (isMember() && mayWrite() || inGroup())
          && uid == me()
          && request.resource.data.keys().hasOnly(['at'])
          && request.resource.data.at == request.time;
        allow delete: if (isMember() || inGroup()) && uid == me();
      }

      match /messages/{messageId} {
        allow read: if isMember() || inGroup();

        // In a group: text messages (with replies) only for now.
        allow create: if (isMember() && mayWrite()
            && existsAfter(/databases/$(database)/documents/chats/$(chatId))
            && validMessage(request.resource.data))
          || (inGroup() && validMessage(request.resource.data)
            && request.resource.data.get('type', 'text') == 'text');

        // The recipient marks messages read; either participant sets or
        // removes their own reaction (reactions {uid: type}).
        allow update: if (isMember()
            && ((resource.data.senderId != me()
                && changed().hasOnly(['status'])
                && request.resource.data.status == 'read')
              || (changed().hasOnly(['reactions']) && validReactionChange())))
          || (inGroup() && changed().hasOnly(['reactions'])
            && validReactionChange());

        function validReactionChange() {
          let after = request.resource.data.get('reactions', {});
          return after is map
            && after.diff(resource.data.get('reactions', {}))
              .affectedKeys().hasOnly([me()])
            && (!after.keys().hasAny([me()])
              || after[me()] in ['heart', 'laugh', 'wow', 'sad', 'fire', 'clap']);
        }

        // "Clear history" clears the chat for both participants; in a group
        // everyone deletes only their own messages.
        allow delete: if isMember()
          || (inGroup() && resource.data.senderId == me());

        function validMessage(d) {
          return d.keys().hasOnly(['senderId', 'text', 'timestamp', 'status',
              'type', 'capsuleId', 'imageUrl', 'replyTo', 'imagePath', 'width',
              'height', 'audioUrl', 'audioPath', 'durationMs', 'waveform',
              'forwarded', 'capsuleRef'])
            && (!d.keys().hasAny(['capsuleRef']) || validCapsuleRef(d.capsuleRef))
            && (!d.keys().hasAny(['replyTo']) || validReply(d.replyTo))
            && d.get('forwarded', true) == true
            && d.senderId == me()
            && d.text is string && d.text.size() > 0 && d.text.size() <= 2000
            && isServerTime(d.timestamp)
            && d.status == 'sent'
            && (!d.keys().hasAny(['type']) || d.type == 'text'
              || (d.type == 'capsule' && validCapsuleMessage(d))
              || (d.type == 'image' && validImageMessage(d))
              || (d.type == 'voice' && validVoiceMessage(d)));
        }

        // A voice message: a recording the sender uploaded to this chat's
        // folder (.m4a), its length (up to 5 minutes) and up to 64 loudness
        // bars. The text is a microphone sign for older app versions.
        function validVoiceMessage(d) {
          return d.audioUrl is string && d.audioUrl.size() <= 2048
            && d.audioPath is string
            && d.audioPath.matches('chats/' + chatId + '/' + me() + '/[A-Za-z0-9]{1,40}[.]m4a')
            && d.durationMs is int && d.durationMs > 0 && d.durationMs <= 300000
            && d.get('waveform', []) is list && d.get('waveform', []).size() <= 64;
        }

        // A photo: a file the sender uploaded to this chat's folder in
        // Storage (storage.rules), its download URL and its size in pixels
        // (so the bubble has its shape before the picture arrives). The text
        // is the caption, or a camera sign for older app versions to show.
        function validImageMessage(d) {
          return d.imageUrl is string && d.imageUrl.size() <= 2048
            && d.imagePath is string
            && d.imagePath.matches('chats/' + chatId + '/' + me() + '/[A-Za-z0-9]{1,40}[.]jpg')
            && d.get('width', 1) is int && d.get('width', 1) > 0
            && d.get('width', 1) <= 10000
            && d.get('height', 1) is int && d.get('height', 1) > 0
            && d.get('height', 1) <= 10000;
        }

        // A quick reply from a capsule names it: its id and a short title
        // (opening it still goes through the capsule's own rules).
        function validCapsuleRef(r) {
          return r is map && r.keys().hasOnly(['id', 'title'])
            && r.id is string && r.id.size() > 0 && r.id.size() <= 200
            && r.title is string && r.title.size() <= 140;
        }

        // A reply quotes a message of this chat: its id, its sender and a
        // short piece of its text.
        function validReply(r) {
          return r is map && r.keys().hasOnly(['id', 'senderId', 'text'])
            && r.id is string && r.id.size() > 0 && r.id.size() <= 200
            && r.senderId in chatMembers()
            && r.text is string && r.text.size() <= 200;
        }

        // Only your own capsule, shared with this chat's other participant.
        function validCapsuleMessage(d) {
          let capsule = get(/databases/$(database)/documents/capsules/$(d.capsuleId));
          return d.capsuleId is string
            && (!d.keys().hasAny(['imageUrl'])
              || (d.imageUrl is string && d.imageUrl.size() <= 2048))
            && capsule.data.ownerId == me()
            && other() in capsule.data.get('sharedWith', []);
        }
      }
    }
  }
}
